---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <a class="brand" href={base}><span class="brand-mark">B</span>Backupist</a>
        <p class="footer-note">A free desktop backup manager for Windows and Linux. Formerly Easy Backup Manager (EBM).</p>
      </div>
      <div class="footer-links">
        <div><b>Explore</b><a href={`${base}downloads/`}>Downloads</a><a href={`${base}changelog/`}>Changelog</a></div>
        <div><b>Project</b><a href={`${base}contact/`}>Contact</a><a href={`${base}donate/`}>Donate</a></div>
      </div>
    </div>
    <div class="footer-bottom"><span>© {year} Backupist</span><span>Freeware · Proprietary software</span></div>
  </div>
</footer>
