---
import PageHero from "../components/PageHero.astro";
import { SITE } from "../config/site";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title={`Donate — ${SITE.name}`}
  description={`Support the development of ${SITE.name} with an optional donation.`}
>
  <PageHero
    eyebrow="Optional, always appreciated"
    title={`Help ${SITE.name} keep going.`}
    description={`${SITE.name} is free to use. If it has made your backup routine easier, an optional donation can help support future maintenance and improvements.`}
  />

  <section class="wrap content">
    <div class="donate-box">
      <span class="kicker">Support independent software</span>
      <h2>Use it for free. Give if you want.</h2>
      <p>
        Donations are voluntary and do not unlock paid features. The app remains
        free to use whether or not you contribute.
      </p>
      <div class="pending">
        Donation link will be added here when the project's preferred platform
        is confirmed.
      </div>
    </div>

    <div class="content-card transparency-card">
      <span class="kicker">Transparency</span>
      <p>
        {SITE.name} is proprietary freeware. Donations support the project but do
        not change the app's licensing or provide ownership rights.
      </p>
    </div>
  </section>
</SiteLayout>
