---
import PageHero from "../components/PageHero.astro";
import { SITE } from "../config/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const platforms = [
  {
    icon: "⊞",
    name: "Windows",
    tag: "Windows desktop",
    description: `Download the ${SITE.name} installer for Windows. Check the release notes for version details before installing.`,
    pending:
      "Windows download link will be added here when the release URL is confirmed.",
  },
  {
    icon: "◈",
    name: "Linux",
    tag: "Linux desktop",
    description: `Download the Linux build of ${SITE.name}. Package format and system requirements will be listed with each release.`,
    pending:
      "Linux download link will be added here when the release URL is confirmed.",
  },
];
---

<SiteLayout
  title={`Downloads — ${SITE.name}`}
  description={`Download ${SITE.name} for Windows or Linux.`}
  active="downloads"
>
  <PageHero
    eyebrow="Choose your platform"
    title={`Get ${SITE.name}.`}
    description={`${SITE.name} is free to download and use. Choose the version for your computer; donations are optional and help support continued development.`}
  />

  <section class="wrap content">
    <div class="card-grid">
      {
        platforms.map((platform) => (
          <article class="download-card">
            <div class="card-top">
              <span class="platform-icon" aria-hidden="true">
                {platform.icon}
              </span>
              <h2>{platform.name}</h2>
            </div>
            <span class="tag">{platform.tag}</span>
            <p>{platform.description}</p>
            <div class="pending">{platform.pending}</div>
          </article>
        ))
      }
    </div>

    <div class="note">
      <b>Before installing:</b> Use the release notes for the version number, platform
      requirements, and any upgrade guidance. {SITE.name} is proprietary freeware;
      its source code is not published.
    </div>
    <a class="button line" href={`${base}changelog/`}>
      Read the changelog ↗
    </a>
  </section>
</SiteLayout>
