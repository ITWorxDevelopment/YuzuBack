---
import PageHero from "../components/PageHero.astro";
import { SITE } from "../config/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const base = import.meta.env.BASE_URL;
const currentRelease = [
  "Updated the Windows package to use restic 0.19.1 instead of the earlier 0.18.x line.",
  "Updated the application build for Qt 6.12.0 LTS.",
  "Included minor bug fixes and compatibility updates.",
];
---

<SiteLayout
  title={`Changelog — ${SITE.name}`}
  description={`${SITE.name} release notes and changelog.`}
  active="changelog"
>
  <PageHero
    eyebrow="What's new"
    title="Changelog."
    description={`Release notes and updates for ${SITE.name}.`}
  />

  <section class="wrap content">
    <div class="note">
      <b>Release number and publication date are being confirmed.</b> The notes below
      summarize changes planned for the current release; they will be updated with
      the official version details and links.
    </div>

    <article class="release">
      <div class="release-date">
        CURRENT RELEASE<br />Version/date pending
      </div>
      <div>
        <h2>Compatibility and maintenance</h2>
        <ul>
          {currentRelease.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </article>

    <article class="release">
      <div class="release-date">
        PREVIOUS RELEASES<br />Archive pending
      </div>
      <div>
        <h2>Earlier releases</h2>
        <p>
          Previous {SITE.name} release notes will be added as the project archive
          is prepared.
        </p>
      </div>
    </article>

    <p class="legal">
      Release version numbers, dates, and detailed notes will be added after
      confirmation against the published release artifacts.
    </p>
    <a class="button line" href={`${base}downloads/`}>Go to downloads ↗</a>
  </section>
</SiteLayout>
