---
import PageHero from "../components/PageHero.astro";
import { SITE } from "../config/site";
import SiteLayout from "../layouts/SiteLayout.astro";

const supportTopics = [
  {
    title: "Bug report",
    description: `Include your ${SITE.name} version, operating system, and steps to reproduce the issue.`,
  },
  {
    title: "Feature idea",
    description: `Describe the task you want ${SITE.name} to make easier and how you handle it today.`,
  },
  {
    title: "General question",
    description:
      "For setup and restore questions, include the relevant profile and restic details, without sharing passwords or repository keys.",
  },
];
---

<SiteLayout
  title={`Contact — ${SITE.name}`}
  description={`Contact the ${SITE.name} project.`}
  active="contact"
>
  <PageHero
    eyebrow="Get in touch"
    title={`Contact ${SITE.name}.`}
    description="Questions, feedback, and bug reports help make the app better. This page is ready for the project's preferred support channels."
  />

  <section class="wrap content contact-layout">
    <article class="content-card">
      <span class="kicker">Support</span>
      <h2>How can we help?</h2>
      {
        supportTopics.map((topic) => (
          <div class="contact-row">
            <b>{topic.title}</b>
            <span>{topic.description}</span>
          </div>
        ))
      }
    </article>

    <aside class="content-card">
      <span class="kicker">Contact channel</span>
      <h2>Support address pending</h2>
      <p>
        The official contact email or issue tracker has not been supplied yet.
      </p>
      <div class="notice">
        Add the project's support email or public issue tracker here before
        sharing this page with visitors.
      </div>
    </aside>
  </section>
</SiteLayout>
